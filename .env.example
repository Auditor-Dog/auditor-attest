# Auditor Attest — environment template.
# Copy to .env and fill in. .env is gitignored; never commit real values.
# Three places read these: local dev (.env), Vercel (project env vars) and the GitHub
# Actions runner (repository secrets/vars). docs/deploy.md says which goes where.

# ─── Database ────────────────────────────────────────────────────────────────
# Local: matches docker-compose.yml. Production: the Neon connection string.
DATABASE_URL=postgresql://auditor:auditor@127.0.0.1:5432/auditor
# Production database, used only by `pnpm db:deploy:prod` and operator scripts run from a laptop.
PROD_DATABASE_URL=

# ─── Solana (devnet) ─────────────────────────────────────────────────────────
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
# Absolute path to the attester keypair JSON, OUTSIDE this repo. Signs on-chain attestations.
# On GitHub Actions the same key is the ATTESTER_KEYPAIR_JSON secret (the file's content).
ATTESTER_KEYPAIR_PATH=
# Program id of audit_attest (deployed on devnet).
AUDIT_ATTEST_PROGRAM_ID=sXtvdoheTtFBukx8vCppJHhiiJHW2xa3xc5KaPAhzkC

# ─── Site ↔ GitHub ───────────────────────────────────────────────────────────
# This site's own public repository: reports are committed there, audits run in its Actions.
SITE_REPO=Auditor-Dog/auditor-attest
SITE_BRANCH=main
# Fine-grained PAT on SITE_REPO with Actions: read+write and Contents: read+write.
# Used by the web tier to size repositories (GitHub API) and to dispatch the audit workflow.
GITHUB_DISPATCH_TOKEN=

# ─── Keys ────────────────────────────────────────────────────────────────────
# 32-byte hex key. The user's Anthropic key is encrypted with it between submission and
# the moment the runner claims the job (then the ciphertext is wiped). Same value on
# Vercel and in the Actions secrets. Generate: openssl rand -hex 32
BYOK_KEK=
# Local worker only (pnpm dev): service key for the legacy `standard` tier. Unused by the site.
ANTHROPIC_API_KEY=

# ─── Pricing ─────────────────────────────────────────────────────────────────
# Path to config/models.json (relative to repo root).
MODELS_CONFIG=config/models.json
# Multiplier on the fitted single-agent cost profile. Default 1.4 (packages/pricing SAFETY_FACTOR).
PRICING_CALIBRATION=
# Hard per-job spend cap passed to the CLI = estimate × BUDGET_FACTOR. Default 1.2.
BUDGET_FACTOR=
# Quotes expire after this many minutes.
QUOTE_TTL_MINUTES=60

# ─── Runner (GitHub Actions and local worker) ────────────────────────────────
REPORTS_DIR=./reports
CORPUS_DIR=./vendor/auditor-skill
CORPUS_VERSION=7.3.0@6bb2cbf
# Wall-clock limit per audit.
MAX_JOB_MINUTES=120
# Optional Claude Code effort level for audit runs (low|medium|high|xhigh|max). Empty = default.
SANDBOX_EFFORT=

# ─── Local worker / Docker sandbox (pnpm dev only) ───────────────────────────
JOBS_DIR=/tmp/auditor-jobs
SANDBOX_IMAGE=auditor-sandbox:latest
EGRESS_PROXY_IMAGE=auditor-egress-proxy:latest
EGRESS_ALLOWED_HOSTS=api.anthropic.com
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
WORKER_POLL_MS=2000
VISIBILITY_SYNC_MS=600000
EGRESS_NETWORK=auditor-egress
EGRESS_PROXY_NAME=auditor-egress-proxy
MAX_JOB_TURNS=2000

# ─── Hand-run example audits ─────────────────────────────────────────────────
# `pnpm dev` ingests every "examples i runned local/<Org>/<repo>/audit_N/REPORT.md" into the
# site when this is set to the model id (config/models.json) of audits without a sidecar.
EXAMPLES_MODEL=
EXAMPLES_VISIBILITY=public

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
